# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
# The Python-floor environment `scripts/ci.py` builds beside .venv, so running
# the 3.10 pass does not delete the 3.12 one every other command uses.
.venv-310/
# A derived view of `uv.lock`, written by the audit step and read by the next
# one. Not committed: a second copy of a dependency set is a second thing that
# can be out of date, and this one would be silently wrong rather than loudly.
.audit-requirements.txt
# `cargo cyclonedx` writes beside Cargo.toml and `scripts/provenance.py` moves the
# file into `dist/`. Ignored as a net for the run that fails between those two.
app/src-tauri/sbom.json
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Key files. Cheap insurance: one of these is every value a scrub removed, and a
# committed one is a re-identification key in the history for good.
*.fdmap
# The one exception: written by the pre-`core/sealed.py` code with its
# randomness pinned, over invented values, so the refactor can be held to the
# old format byte for byte. See tests/test_sealed.py.
!engine/tests/fixtures/before-sealed.fdmap
# A term list is a firm's client register, for the same reason.
*.fdterms

# Models downloaded at first run, never bundled
engine/models/

# Node / Tauri
node_modules/
app/dist/
app/build/
app/.svelte-kit/
app/src-tauri/target/
# The portable bundle and the WebView2 runtime it carries. Both are build output
# and the runtime is 180 MB of Microsoft's, fetched per release rather than kept.
app/dist-portable/
# The Intune package and its settings sheet, rebuilt from the .msi on demand.
app/dist-intune/
app/src-tauri/webview2/
app/src-tauri/gen/

# The PyInstaller sidecar: ~650 MB, rebuilt per platform on the platform.
engine/packaging/dist/
engine/packaging/build/

# IntelliJ
out/

# macOS
.DS_Store

# Scrub output from manual runs — may contain real data
/tmp-out/
*.freedocs-report.json
