# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
# The Python-floor environment `scripts/ci.py` builds beside .venv, so running
# the 3.10 pass does not delete the 3.12 one every other command uses.
.venv-310/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Models downloaded at first run, never bundled
engine/models/

# Node / Tauri
node_modules/
app/dist/
app/build/
app/.svelte-kit/
app/src-tauri/target/
# The portable bundle and the WebView2 runtime it carries. Both are build output
# and the runtime is 180 MB of Microsoft's, fetched per release rather than kept.
app/dist-portable/
app/src-tauri/webview2/
app/src-tauri/gen/

# The PyInstaller sidecar: ~650 MB, rebuilt per platform on the platform.
engine/packaging/dist/
engine/packaging/build/

# IntelliJ
out/

# macOS
.DS_Store

# Scrub output from manual runs — may contain real data
/tmp-out/
*.freedocs-report.json
