{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeDocs",
  "version": "0.3.0-dev.0",
  "identifier": "ch.realise.freedocs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FreeDocs",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "deb", "appimage", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Remove confidential data from documents, locally",
    "longDescription": "FreeDocs finds confidential data in PDF, Word, Excel and PowerPoint files and removes it, so a document can be handed to an AI service without handing over the data. Everything runs on this machine.",
    "resources": {
      "../../engine/dist/freedocs-engine": "freedocs-engine"
    },
    "windows": {
      "wix": {
        "upgradeCode": "9b739aa3-694f-5e3b-b9a3-fd637b39bbda"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["tesseract-ocr"]
      }
    }
  }
}
